# Base URL for the backend API.
# Leave empty to use relative paths (dev server proxy, or production same-origin serving).
VITE_API_BASE_URL=

# Backend the Vite dev server proxies /api to.
VITE_DEV_BACKEND_URL=http://localhost:8000

# Fallback used when the app is opened as a file:// URL.
VITE_FILE_FALLBACK_API_URL=https://temp-master.fly.dev
