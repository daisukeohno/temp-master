# Optional. Overrides the API base URL used by the dashboard.
# Leave empty to use the same origin (the FastAPI backend serving the built app).
# During `npm run dev`, requests to /api are proxied to VITE_DEV_PROXY_TARGET instead.
VITE_API_URL=

# Backend target used by the Vite dev server proxy.
VITE_DEV_PROXY_TARGET=http://localhost:8000
