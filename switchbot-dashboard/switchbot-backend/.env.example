# SwitchBot API Credentials
# Get these from the SwitchBot app:
# 1. Go to Profile > Preferences > About
# 2. Tap App Version 10 times to enable Developer Options
# 3. Go to Developer Options > Get Token

SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here

# API Key Authentication
# 書き込み・エクスポート系エンドポイント(/api/backup, /api/import, /api/meters/refresh)を
# 保護するための API キー。リクエストの X-API-Key ヘッダと照合されます。
# 未設定の場合、これらのエンドポイントは 503 を返します(読み取り専用エンドポイントは影響を受けません)。
API_KEY=your_api_key_here

# CORS Allowed Origins
# クロスオリジンリクエストを許可するオリジンをカンマ区切りで指定します。
# 例: https://temp-master.fly.dev,http://localhost:8000
# 未設定(空)の場合、クロスオリジンアクセスは許可されません。
ALLOWED_ORIGINS=
