# SwitchBot API Credentials
# Get these from the SwitchBot app:
# 1. Go to Profile > Preferences > About
# 2. Tap App Version 10 times to enable Developer Options
# 3. Go to Developer Options > Get Token

SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here

# Bearer token required by the administrative endpoints (GET /api/backup, POST /api/import).
# Generate one with: openssl rand -hex 32
# If unset, these endpoints return 503 (fail closed).
API_TOKEN=your_api_token_here

# Comma separated list of browser origins allowed to call the API (CORS).
# Defaults to https://temp-master.fly.dev,http://localhost:8000,http://localhost:5173
ALLOWED_ORIGINS=https://temp-master.fly.dev,http://localhost:8000,http://localhost:5173
