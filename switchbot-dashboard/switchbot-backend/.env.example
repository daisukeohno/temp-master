# SwitchBot API Credentials
# Get these from the SwitchBot app:
# 1. Go to Profile > Preferences > About
# 2. Tap App Version 10 times to enable Developer Options
# 3. Go to Developer Options > Get Token

SWITCHBOT_TOKEN=your_token_here
SWITCHBOT_SECRET=your_secret_here

# 管理者APIキー（必須）
# /api/backup, /api/import, /api/meters/refresh の認証に使用します。
# 未設定の場合、これらのエンドポイントは 503 で無効化されます（fail-closed）。
# 十分に長いランダム値を設定してください（例: openssl rand -hex 32）。
# リクエスト時は X-API-Key ヘッダー、または Authorization: Bearer <token> で送信します。
ADMIN_API_KEY=your_admin_api_key_here

# CORS 許可オリジン（カンマ区切り）
# 未設定時の既定値: http://localhost:8000,http://127.0.0.1:8000
# ワイルドカード(*)は使用しないでください。
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
